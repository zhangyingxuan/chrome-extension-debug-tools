{
  "manifest_version": 3,
  "name": "前端研发专用调试增强器",
  "version": "1.0",
  "description": "让前端工程师在浏览器里完成「调试 + 环境切换 + 真机采样」三位一体的私有外挂，无需 Charles、无需 root、一套插件即插即用。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "declarative_net_request": {
    "rule_resources": []
  },

  "action": {
    "default_icon": {
      "48": "sources/netIntercept64.png",
      "64": "sources/netIntercept64.png",
      "128": "sources/netIntercept128.png"
    }
  },
  "icons": {
    "64": "sources/netIntercept64.png",
    "128": "sources/netIntercept128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools.html"
}
